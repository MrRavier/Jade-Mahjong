[application]
config/name="Jade Mahjong"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://art/jade_icon.png"
boot_splash/image="res://art/jade_icon.png"
boot_splash/bg_color=Color(0.0196, 0.0706, 0.0627, 1)

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1
window/energy_saving/keep_screen_on=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.0118, 0.0353, 0.0314, 1)

[audio]
driver/enable_input=false

[network]
limits/debugger/max_queued_messages=2048

